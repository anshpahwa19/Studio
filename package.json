{
  "name": "salon-studio",
  "version": "2.0.0",
  "private": true,
  "description": "Salon and nail studio management for Shruti Pahwa Luxury Salon & Academy",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "setup:fresh": "prisma db push --force-reset && tsx prisma/seed.ts --empty --reset",
    "setup:demo": "prisma db push --force-reset && tsx prisma/seed.ts --reset",
    "desktop": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "5.2.8",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "html-to-image": "1.11.11",
    "jspdf": "2.5.2",
    "lucide-react": "0.453.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.6.2",
    "electron": "41.7.1",
    "electron-builder": "26.18.0",
    "postcss": "8.5.32",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.shrutipahwa.salonstudio",
    "productName": "Salon Studio",
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ]
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "!.next/cache/**/*",
      "prisma/schema.prisma",
      "prisma/dev.db",
      "node_modules/**/*",
      "package.json",
      "next.config.mjs"
    ],
    "asar": false
  }
}
