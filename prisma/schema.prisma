// Salon Studio database. Money is stored in rupees, dates as "YYYY-MM-DD", times as "HH:mm".

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String // Owner | Manager | Receptionist | Stylist
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  sessions     Session[]
}

// One row per signed-in browser or app. Signing out deletes it, which cancels that token straight away.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Single row (id = 1) holding the business profile.
model Settings {
  id             Int    @id @default(1)
  name           String
  address        String @default("")
  phone          String @default("")
  email          String @default("")
  gstin          String @default("")
  openTime       String @default("09:00")
  closeTime      String @default("21:00")
  invoicePrefix  String @default("INV")
  nextInvoiceNo  Int    @default(1001)
  gstRate        Float  @default(5) // applied to every bill that charges GST
  invoiceFooter  String @default("Thank you for visiting us.")
}

model Branch {
  id           String        @id @default(cuid())
  name         String
  address      String        @default("")
  active       Boolean       @default(true)
  appointments Appointment[]
  invoices     Invoice[]
  expenses     Expense[]
  stockMovements StockMovement[]
  customers    Customer[]
}

model Customer {
  id               String        @id @default(cuid())
  name             String
  phone            String        @unique
  email            String?
  gender           String?
  birthday         String?
  address          String?
  notes            String?
  hairNotes        String?
  nailNotes        String?
  preferredStaffId String?
  branchId         String?
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  preferredStaff   Staff?        @relation(fields: [preferredStaffId], references: [id])
  branch           Branch?       @relation(fields: [branchId], references: [id])
  appointments     Appointment[]
  invoices         Invoice[]

  @@index([name])
}

model Staff {
  id             String               @id @default(cuid())
  name           String
  phone          String               @unique
  email          String?
  title          String               @default("Stylist")
  skills         String               @default("") // comma separated
  payType        String               @default("Commission") // Commission | Salary
  commissionRate Float                @default(0) // % of service revenue, when payType is Commission
  monthlySalary  Float                @default(0) // rupees per month, when payType is Salary
  workDays       String               @default("1,2,3,4,5,6") // 0 = Sunday
  startTime      String               @default("09:00")
  endTime        String               @default("20:00")
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  appointments   Appointment[]
  preferredBy    Customer[]
  invoiceItems   InvoiceItem[]
  attendance     Attendance[]
}

// One row per staff member per day they punched in. A working day with no row counts as absent.
model Attendance {
  id        String   @id @default(cuid())
  staffId   String
  date      String
  checkIn   String // HH:mm
  checkOut  String? // HH:mm
  createdAt DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@index([date])
}

model ServiceCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id          String               @id @default(cuid())
  name        String
  description String?
  categoryId  String
  price       Float
  duration    Int // minutes
  active      Boolean              @default(true)
  category    ServiceCategory      @relation(fields: [categoryId], references: [id])
  bookings    AppointmentService[]
  invoiceItems InvoiceItem[]
}

model Appointment {
  id        String               @id @default(cuid())
  customerId String
  staffId   String
  branchId  String?
  date      String
  startTime String
  endTime   String
  status    String               @default("Booked") // Booked | CheckedIn | InService | Completed | Cancelled | NoShow
  walkIn    Boolean              @default(false)
  notes     String?
  createdAt DateTime             @default(now())
  customer  Customer             @relation(fields: [customerId], references: [id])
  staff     Staff                @relation(fields: [staffId], references: [id])
  branch    Branch?              @relation(fields: [branchId], references: [id])
  services  AppointmentService[]
  invoice   Invoice?

  @@index([date])
  @@index([staffId, date])
}

model AppointmentService {
  id            String      @id @default(cuid())
  appointmentId String
  serviceId     String
  name          String
  price         Float
  duration      Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])
}

model Supplier {
  id        String          @id @default(cuid())
  name      String          @unique
  contact   String? // contact person
  phone     String?
  email     String?
  address   String?
  gstin     String?
  notes     String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  products  Product[]
  movements StockMovement[]
  bills     SupplierBill[]
}

// A bill received from a supplier for goods bought, and the payments made against it.
model SupplierBill {
  id         String            @id @default(cuid())
  supplierId String
  billNumber String? // optional: the bill itself is the record
  date       String
  dueDate    String?
  amount     Float // total payable, including any GST
  paid       Float             @default(0)
  notes      String?
  fileName   String? // the uploaded copy of the bill (photo or PDF), kept in the database
  fileType   String?
  fileData   Bytes?
  createdAt  DateTime          @default(now())
  supplier   Supplier          @relation(fields: [supplierId], references: [id])
  payments   SupplierPayment[]

  @@unique([supplierId, billNumber])
  @@index([date])
}

model SupplierPayment {
  id        String       @id @default(cuid())
  billId    String
  date      String
  amount    Float
  method    String // Cash | UPI | Card | Bank
  reference String?
  createdAt DateTime     @default(now())
  bill      SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model Product {
  id           String          @id @default(cuid())
  name         String
  sku          String?         @unique
  category     String          @default("General")
  supplierId   String?
  costPrice    Float           @default(0)
  price        Float
  stock        Int             @default(0)
  reorderLevel Int             @default(5)
  unit         String          @default("pcs")
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  supplierRef  Supplier?       @relation(fields: [supplierId], references: [id])
  movements    StockMovement[]
  invoiceItems InvoiceItem[]
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  type      String // IN | OUT | ADJUST | SALE | RETURN | TRANSFER
  change    Int // signed
  balance   Int // that branch's count after this movement
  note      String?
  invoiceId String?
  supplierId String? // who the stock was received from (IN only)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])
  branchId  String? // which branch's shelf this moved
  branch    Branch?   @relation(fields: [branchId], references: [id])

  @@index([productId, createdAt])
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  customerId    String
  appointmentId String?       @unique
  branchId      String?
  subtotal      Float
  discountType  String? // percent | amount
  discountValue Float         @default(0)
  discount      Float         @default(0)
  tax           Float         @default(0)
  total         Float
  paid          Float         @default(0)
  refunded      Float         @default(0) // money given back to the client; paid is never reduced
  status        String // Paid | Partial | Unpaid | Cancelled
  notes         String?
  createdBy     String?
  createdAt     DateTime      @default(now())
  customer      Customer      @relation(fields: [customerId], references: [id])
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  branch        Branch?       @relation(fields: [branchId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]
  refunds       Refund[]

  @@index([createdAt])
  @@index([customerId])
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  kind      String // service | product
  serviceId String?
  productId String?
  staffId   String?
  name      String
  qty       Int
  unitPrice Float
  taxRate   Float // GST % charged on this line (0 when the bill has no GST)
  discount  Float    @default(0)
  tax       Float    @default(0)
  total     Float // after discount, including tax
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service   Service? @relation(fields: [serviceId], references: [id])
  product   Product? @relation(fields: [productId], references: [id])
  staff     Staff?   @relation(fields: [staffId], references: [id])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  method    String // Cash | UPI | Card | Bank
  reference String?
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// Money handed back to a client for a bill. The bill's total and paid amounts stay as they were.
model Refund {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  method    String // Cash | UPI | Card | Bank
  reason    String
  createdBy String?
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Expense {
  id          String   @id @default(cuid())
  date        String
  category    String
  description String
  amount      Float
  method      String   @default("Cash")
  vendor      String?
  branchId    String?
  createdAt   DateTime @default(now())
  branch      Branch?  @relation(fields: [branchId], references: [id])

  @@index([date])
}
